generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  caravaneiro
}

enum CampanhaTipo {
  DISTRIBUICAO
  COLETA
  ESPECIAL
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  role      Role
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  caravaneiro Caravaneiro?

  @@map("users")
}

model Caravaneiro {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  nome      String
  telefone  String?
  email     String?
  ativo     Boolean  @default(true)
  publicId  String   @unique @map("public_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("caravaneiros")
}

/// Módulo Campanhas — fase futura
model Campanha {
  id         String        @id @default(uuid()) @db.Uuid
  nome       String
  tipo       CampanhaTipo
  dataInicio DateTime?     @map("data_inicio")
  dataFim    DateTime?     @map("data_fim")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@map("campanhas")
}

/// Módulo Rotas — fase futura
model Rota {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rotas")
}

/// Módulo Frequência — fase futura
model Presenca {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("presencas")
}

/// Módulo Arrecadações — fase futura
model Arrecadacao {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@map("arrecadacoes")
}
