# =============================================================================
#  Luz da Esperança — modelo de variáveis de ambiente
# =============================================================================
#
#  COMO USAR
#    cp .env.example .env.local
#  e preencha os valores com os dados do SEU projeto Supabase.
#
#  Use .env.local, não .env: é o arquivo que o Next.js carrega com precedência
#  para desenvolvimento, e o .gitignore já o protege.
#
#  ⚠️  ESTE ARQUIVO VAI PARA O REPOSITÓRIO. Só placeholders aqui — nunca cole
#      chave, senha ou connection string de verdade neste arquivo.
#      (Já aconteceu: até 2026-08-28 este arquivo continha as credenciais reais
#      de um projeto ativo. As três foram rotacionadas e invalidadas.)
#
#  Onde achar cada valor, no painel do Supabase:
#    https://supabase.com/dashboard/project/SEU-PROJECT-REF
#
# =============================================================================


# -----------------------------------------------------------------------------
# OBRIGATÓRIAS — em produção e em desenvolvimento
# -----------------------------------------------------------------------------

# Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co

# Project Settings → API Keys → publishable / anon key
# PÚBLICA: vai no JavaScript do navegador, qualquer visitante consegue ler.
# Por isso o RLS existe — veja supabase/migrations/20260828000000_rls_completo.sql
# O código aceita qualquer um dos dois nomes; use o que o painel mostrar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Project Settings → API Keys → secret / service_role key
# 🔒 SECRETA. Ignora RLS por completo: quem tem esta chave lê e escreve tudo.
# Nunca prefixe com NEXT_PUBLIC_, nunca use em componente client, nunca commite.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# SUPABASE_SECRET_KEY=your-secret-key

# URL pública do site. Compõe o link do QR Code lido pela câmera na chamada,
# que exige HTTPS fora do localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# OBRIGATÓRIA APENAS LOCALMENTE — não cadastre no Netlify
# -----------------------------------------------------------------------------

# Connection → ORMs (ou Project Settings → Database → Connection string), modo Session.
# 🔒 SECRETA: contém a senha do banco.
# Usada só por `npm run db:seed` e pelo backup (.github/workflows/backup.yml).
# O runtime do site NÃO usa esta variável — ele fala com o Supabase pela API.
# Troque [SENHA-DO-BANCO] pela senha real, SEM os colchetes.
DATABASE_URL=postgresql://postgres:[SENHA-DO-BANCO]@db.SEU-PROJECT-REF.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# OPCIONAIS — só para `npm run db:seed`, que cria o admin inicial
# -----------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador
