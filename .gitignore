# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# cursor
.cursor/

# misc
.DS_Store
Thumbs.db

# chaves e certificados
*.pem
*.key
*.p12
*.pfx

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca commitar segredos
# .env.* cobre TUDO (.env.production, .env.development, .env.test, .env.bak,
# .env.old, .env.backup...). O Next.js carrega .env.production e
# .env.development de verdade, então eles podem conter segredos.
# A única exceção é o modelo .env.example, que só tem placeholders.
.env
.env.*
!.env.example

# plataforma de deploy
.netlify/
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# supabase CLI — estado local do link, pode conter token/ref
supabase/.temp/
.supabase/

# dumps e backups de banco — o workflow de backup gera .sql.gz;
# nunca versionar dados reais de campanha (LGPD)
*.sql.gz
*.dump
*.backup
backup*.sql
dump*.sql

# editores e ferramentas locais
.vscode/
.idea/
.claude/settings.local.json
